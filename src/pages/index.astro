---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile.js";
import { projects } from "../data/projects.js";
import { experience } from "../data/experience.js";
import { skillGroups } from "../data/skills.js";
import { demo } from "../data/demo.js";

const title = `${profile.name} | ${profile.title}`;

const profiles = [
  {
    label: "LinkedIn",
    detail: "My professional profile",
    url: profile.links.linkedin,
  },
  {
    label: "GitHub",
    detail: "My public repositories and code samples",
    url: profile.links.github,
  },
  {
    label: "Credly",
    detail: "My certification profile",
    url: profile.links.credly,
  },
  {
    label: "TryHackMe",
    detail: "My account for hands-on cybersecurity learning",
    url: profile.links.tryHackMe,
  },
];
---

<BaseLayout title={title} description={profile.summary}>
  <header class="sticky top-0 z-30 border-b border-[color:var(--line)] bg-[color:var(--header)]/92 backdrop-blur-xl">
    <div class="mx-auto flex min-h-[72px] w-full max-w-[1240px] items-center gap-6 px-5 md:px-8">
      <a href="#top" aria-label={`${profile.name} homepage`} class="inline-flex items-center gap-3 text-[var(--ink)] no-underline">
        <span class="brand-mark">GG</span>
        <span class="text-sm font-extrabold tracking-tight sm:text-base">{profile.name}</span>
      </a>
      <nav aria-label="Main navigation" class="ml-auto hidden items-center gap-5 text-sm font-bold text-[var(--muted)] lg:flex">
        <a href="#proof" class="transition hover:text-[var(--accent)]">Highlights</a>
        <a href="#projects" class="transition hover:text-[var(--accent)]">Projects</a>
        <a href="#experience" class="transition hover:text-[var(--accent)]">Experience</a>
        <a href="#skills" class="transition hover:text-[var(--accent)]">Skills</a>
        <a href="#profiles" class="transition hover:text-[var(--accent)]">Profiles</a>
        <a href="#demo" class="transition hover:text-[var(--accent)]">Demo</a>
        <a href="#contact" class="transition hover:text-[var(--accent)]">Contact</a>
      </nav>
      <button
        id="themeToggle"
        type="button"
        aria-label="Toggle dark mode"
        class="inline-flex min-h-10 items-center justify-center rounded-md border border-[color:var(--line)] bg-[var(--surface)] px-3 text-sm font-black text-[var(--ink)] transition hover:border-[var(--accent)] hover:text-[var(--accent-strong)]"
      >
        Mode
      </button>
    </div>
  </header>

  <main id="top">
    <section class="hero-shell relative isolate overflow-hidden bg-[var(--night)] text-white">
      <div class="mx-auto grid min-h-[78vh] w-full max-w-[1240px] items-center gap-10 px-5 py-20 md:px-8 lg:grid-cols-[minmax(0,1.08fr)_minmax(320px,0.92fr)] lg:py-28">
        <div class="relative z-10 max-w-4xl">
          <p class="mb-3 text-xs font-black uppercase tracking-[0.08em] text-[#7dd3c1]">{profile.location}</p>
          <h1 class="max-w-4xl text-balance font-display text-5xl font-bold leading-[0.9] tracking-tight sm:text-6xl lg:text-8xl">
            {profile.name}
          </h1>
          <p class="mt-5 max-w-4xl text-balance font-display text-2xl font-bold leading-[1.05] tracking-tight text-[#f7d690] sm:text-3xl lg:text-5xl">
            {profile.title}
          </p>
          <p class="mt-6 max-w-3xl text-lg leading-8 text-[#d8e2e8] sm:text-xl">
            {profile.summary}
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="button-primary" href="/Resume/George_Girgis_Resume.pdf" download>Download Resume</a>
            <a class="button-secondary" href="#projects">View Projects</a>
          </div>
        </div>
        <div class="relative hidden lg:block">
          <img
            src="/img/coding.svg"
            alt="Developer illustration"
            class="mx-auto w-full max-w-[520px] drop-shadow-[0_28px_90px_rgba(0,0,0,0.42)]"
          />
        </div>
      </div>
    </section>

    <section id="proof" class="section-shell">
      <div class="section-head">
        <p class="eyebrow">Highlights</p>
        <h2 class="section-title">Credentials and technical focus</h2>
        <p class="section-copy">
          A snapshot of the education, certifications, and hands-on areas I bring into network and security work.
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {profile.highlights.map((item) => (
          <article class="surface-card p-5">
            <strong class="block text-lg font-extrabold leading-6 text-[var(--ink)]">{item.label}</strong>
            <span class="mt-3 block text-[15px] leading-7 text-[var(--muted)]">{item.detail}</span>
            {item.link && (
              <a
                class="mt-4 inline-flex font-extrabold text-[var(--accent-strong)] transition hover:underline"
                href={item.link}
                target="_blank"
                rel="noreferrer"
              >
                {item.linkLabel || "View credential"}
              </a>
            )}
          </article>
        ))}
      </div>
    </section>

    <section id="projects" class="section-shell bg-[var(--bg-muted)]">
      <div class="section-head">
        <p class="eyebrow">Featured Work</p>
        <h2 class="section-title">Selected projects and workstreams</h2>
        <p class="section-copy">
          A few examples of how I approach automation, analytics, and security problems in practical environments.
        </p>
      </div>
      <div class="grid gap-5 xl:grid-cols-3">
        {projects.map((project) => (
          <article class="surface-card flex h-full flex-col p-6">
            <span class="eyebrow mb-4">{project.eyebrow}</span>
            <h3 class="font-display text-2xl font-bold tracking-tight text-[var(--ink)]">{project.title}</h3>
            <p class="mt-3 text-[15px] leading-7 text-[var(--muted)]">{project.summary}</p>
            <ul class="mt-5 space-y-3 pl-5 text-[15px] leading-7 text-[var(--muted)] marker:text-[var(--accent)]">
              {project.impact.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <div class="mt-auto flex flex-wrap gap-2 pt-3">
              {project.stack.map((item) => (
                <span class="tag-chip">{item}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="experience" class="section-shell">
      <div class="section-head">
        <p class="eyebrow">Experience Timeline</p>
        <h2 class="section-title">Recent roles</h2>
        <p class="section-copy">
          A concise view of the roles that shaped my cybersecurity, network operations, automation, and IT support experience.
        </p>
      </div>
      <div class="mx-auto grid max-w-[980px] gap-6">
        {experience.map((job, index) => (
          <article class="grid grid-cols-[20px_minmax(0,1fr)] gap-4 md:grid-cols-[24px_minmax(0,1fr)] md:gap-5">
            <div class="relative">
              <span class="mt-1 block h-3.5 w-3.5 rounded-full border-[3px] border-[var(--accent)] bg-[var(--surface)]"></span>
              {index < experience.length - 1 && <span class="timeline-line"></span>}
            </div>
            <div>
              <p class="eyebrow mb-2">{job.dates} | {job.location}</p>
              <h3 class="font-display text-2xl font-bold tracking-tight text-[var(--ink)]">{job.role}</h3>
              <p class="mt-2 text-base font-black text-[var(--gold)]">{job.company}</p>
              <ul class="mt-4 space-y-3 pl-5 text-[15px] leading-7 text-[var(--muted)] marker:text-[var(--accent)]">
                {job.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="skills" class="section-shell bg-[var(--bg-muted)]">
      <div class="section-head">
        <p class="eyebrow">Skills</p>
        <h2 class="section-title">Technical toolkit</h2>
        <p class="section-copy">
          Grouped around the kinds of problems I enjoy working on: secure networks, operational tooling, and repeatable analysis.
        </p>
      </div>
      <div class="grid gap-5 lg:grid-cols-2">
        {skillGroups.map((group) => (
          <article class="surface-card p-6">
            <h3 class="font-display text-2xl font-bold tracking-tight text-[var(--ink)]">{group.name}</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class="tag-chip">{skill}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="profiles" class="section-shell">
      <div class="section-head">
        <p class="eyebrow">Profiles</p>
        <h2 class="section-title">Where to verify and explore more</h2>
        <p class="section-copy">
          These links collect my public technical footprint separately from direct contact.
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {profiles.map((item) => (
          <a
            class="surface-card flex min-h-[148px] flex-col justify-between p-5 no-underline transition duration-200 hover:-translate-y-0.5 hover:border-[color:var(--accent)]"
            href={item.url}
            target="_blank"
            rel="noreferrer"
          >
            <strong class="text-xl font-extrabold tracking-tight text-[var(--ink)]">{item.label}</strong>
            <span class="mt-6 text-[15px] leading-7 text-[var(--muted)]">{item.detail}</span>
          </a>
        ))}
      </div>
    </section>

    <section id="demo" class="section-shell">
      <div class="section-head">
        <p class="eyebrow">{demo.eyebrow}</p>
        <h2 class="section-title">{demo.title}</h2>
        <p class="section-copy">
          {demo.description}
        </p>
      </div>
      <div class="surface-video mx-auto overflow-hidden">
        <iframe
          class="block h-full w-full aspect-video"
          src={demo.embedUrl}
          title={demo.title}
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
      <div class="mt-5 flex justify-center">
        <a
          class="inline-flex w-fit font-extrabold text-[var(--accent-strong)] transition hover:underline"
          href={demo.youtubeUrl}
          target="_blank"
          rel="noreferrer"
        >
          Open on YouTube
        </a>
      </div>
    </section>

    <section id="contact" class="bg-[var(--night)] px-5 py-16 text-white md:px-8 lg:py-24">
      <div class="mx-auto grid max-w-[1240px] gap-10 lg:grid-cols-[minmax(0,0.92fr)_minmax(320px,1fr)] lg:items-center">
        <div>
          <p class="eyebrow">Resume + Contact</p>
          <h2 class="font-display text-4xl font-bold tracking-tight sm:text-5xl">Let us make the next conversation easy.</h2>
          <p class="mt-4 max-w-2xl text-lg leading-8 text-[#c8d1d7]">
            Download my current resume or reach me directly by email.
          </p>
        </div>
        <div class="grid justify-start gap-4">
          <div class="flex flex-wrap gap-3">
            <a class="button-primary" href="/Resume/George_Girgis_Resume.pdf" download>Download Resume</a>
            <button
              id="copyEmailButton"
              type="button"
              data-email={profile.email}
              data-default-label="Copy Email"
              class="button-secondary"
            >
              Copy Email
            </button>
          </div>
          <p class="text-base font-extrabold text-[#f4f7f9]">{profile.email}</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-[#080a0d] px-5 py-6 text-[#c8d1d7] md:px-8">
    <div class="mx-auto flex max-w-[1240px] flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <span>&copy; {new Date().getFullYear()} {profile.name}</span>
      <a href="#top" class="font-extrabold text-white transition hover:text-[var(--accent-strong)]">Back to top</a>
    </div>
  </footer>

  <script is:inline>
    const themeToggle = document.getElementById("themeToggle");
    const copyEmailButton = document.getElementById("copyEmailButton");

    const setThemeLabel = () => {
      if (!themeToggle) return;
      const isDark = document.documentElement.dataset.theme === "dark";
      themeToggle.textContent = isDark ? "Light" : "Dark";
      themeToggle.setAttribute(
        "aria-label",
        isDark ? "Switch to light mode" : "Switch to dark mode"
      );
    };

    setThemeLabel();

    themeToggle?.addEventListener("click", () => {
      const nextTheme =
        document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = nextTheme;
      try {
        localStorage.setItem("theme", nextTheme);
      } catch {}
      setThemeLabel();
    });

    copyEmailButton?.addEventListener("click", async () => {
      const email = copyEmailButton.dataset.email || "";
      const defaultLabel = copyEmailButton.dataset.defaultLabel || "Copy Email";

      try {
        await navigator.clipboard.writeText(email);
        copyEmailButton.textContent = "Copied";
      } catch {
        window.prompt("Copy email address:", email);
        copyEmailButton.textContent = "Copy Shown";
      }

      window.setTimeout(() => {
        copyEmailButton.textContent = defaultLabel;
      }, 1800);
    });
  </script>
</BaseLayout>
